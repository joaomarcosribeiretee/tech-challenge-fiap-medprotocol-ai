# Copie para .env e ajuste. Nunca versione o arquivo .env.

# Ambiente: dev | test | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Caminhos locais
DATA_DIR=data
SQLITE_PATH=data/processed/medprotocol.db
VECTORSTORE_DIR=data/vectorstore

# Fine-tuning (definido na etapa de fine-tuning)
BASE_MODEL_NAME=
ADAPTER_DIR=models/adapters

# Token do Hugging Face, se necessário para baixar modelos. Deixe vazio aqui.
HF_TOKEN=
