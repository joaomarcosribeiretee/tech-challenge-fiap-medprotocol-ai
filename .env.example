# Copie para .env e ajuste. Nunca versione o arquivo .env.

# Ambiente: dev | test | prod
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Caminhos locais
DATA_DIR=data
SQLITE_PATH=data/processed/medprotocol.db
VECTORSTORE_DIR=data/vectorstore

# Fine-tuning e inferência (Etapas 4-5). O modelo-base, a revisão e o adaptador vêm do JSON de
# configuração; MODEL_VARIANT escolhe entre o modelo ajustado (padrão) e o base.
BASE_MODEL_NAME=
ADAPTER_DIR=models/adapters
MODEL_CONFIG=configs/finetune/qwen2.5-1.5b-lora-v1.json
MODEL_VARIANT=ajustado

# Auditoria do fluxo LangGraph (JSONL, sem texto de pergunta/resposta)
AUDIT_LOG_PATH=logs/audit.jsonl

# Token do Hugging Face, se necessário para baixar modelos. Deixe vazio aqui.
HF_TOKEN=
